# Environment Configuration for Venue Crowd Management System

# Flask Secret Key for session signing
FLASK_SECRET_KEY=replace-with-a-secure-random-secret-key-32-chars

# Master Cryptographic HMAC Secret Key for Anti-Fraud Pass Signing
HMAC_SECRET_KEY=SECURE_VENUE_HMAC_MASTER_KEY_2026_@ANTIFRAUD

# Private Admin Dashboard Password
ADMIN_PASSWORD=admin123

# Port to bind server (Default: 5000)
PORT=5000
