# ================================================================
# Event Crowd Management System — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env to Git.
# ================================================================

# ── Flask Security Keys ──────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change_me_to_a_long_random_hex_string
HMAC_SECRET_KEY=change_me_to_another_long_random_hex_string

# ── Admin Credentials ────────────────────────────────────────────
ADMIN_PASSWORD=change_me_strong_password

# ── Guard Portal Settings ────────────────────────────────────────
GUARD_PIN=change_me_guard_password
GUARD_PIN_REQUIRED=true
GUARD_SESSION_MINUTES=15

# ── Database Configuration ────────────────────────────────────────
# Option A: SQLite (default, no setup needed, NOT cross-device)
DB_TYPE=sqlite

# Option B: PostgreSQL (RECOMMENDED for cross-device access)
# Uncomment the DATABASE_URL line below. This overrides DB_TYPE.
# Format: postgresql://user:password@host:5432/dbname
# DATABASE_URL=postgresql://myuser:mypassword@localhost:5432/eventcrowd

# Option C: MySQL
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_mysql_password
# DB_NAME=event_crowd

# ── Server Port ──────────────────────────────────────────────────
PORT=5000

# ── Event Configuration (can also be set via Admin Panel) ────────
EVENT_NAME=Event 2026
EVENT_VENUE=To Be Announced
EVENT_DATE=2026-12-31
EVENT_CAPACITY=5000
EVENT_DESCRIPTION=Smart crowd management for your event.

# ── PostgreSQL Hosted Options ─────────────────────────────────────
# For a free hosted PostgreSQL, use one of:
# - Supabase (supabase.com) — Free tier available
# - Railway (railway.app) — Free starter plan
# - Neon (neon.tech) — Free tier with 0.5 GB
# - ElephantSQL (elephantsql.com) — Free 20 MB
#
# After creating your database, set DATABASE_URL to the connection string.
# Example (Supabase):
# DATABASE_URL=postgresql://postgres:your_password@db.xxxx.supabase.co:5432/postgres
