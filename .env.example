# ===============================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure your private credentials.
# NEVER COMMIT YOUR REAL .env FILE OR API KEYS TO GITHUB!
# ===============================================================

# Flask Secret Key for session cookie signing
FLASK_SECRET_KEY=your_random_64_character_secret_key_here

# Master Cryptographic HMAC Secret Key for Anti-Fraud Pass Signing
HMAC_SECRET_KEY=your_private_hmac_master_key_here

# Private Admin Dashboard Password
ADMIN_PASSWORD=your_secure_admin_password

# Port to bind server (Default: 5000)
PORT=5000

# ---------------------------------------------------------------
# DATABASE CONFIGURATION
# ---------------------------------------------------------------
# DB_TYPE: 'mysql' for MySQL server, or 'sqlite' for zero-config file DB
DB_TYPE=mysql

# MySQL Server Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=venue_user
DB_PASSWORD=your_secure_mysql_password
DB_NAME=venue_crowd
