# ================================================================
# VenueGuard — Smart Crowd Control Management System
# Environment Configuration Template
# Copy this file to .env and provide strong, unique secrets.
# NEVER commit your actual .env to Git or expose publicly.
# ================================================================

# ── Flask Security Keys ──────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change_me_to_a_long_random_hex_string
HMAC_SECRET_KEY=change_me_to_another_long_random_hex_string

# ── Admin & Staff Authentication ─────────────────────────────────
# Set strong, non-default credentials for venue security
ADMIN_PASSWORD=change_me_strong_admin_password
GUARD_PIN=change_me_strong_guard_password
GUARD_PIN_REQUIRED=true
GUARD_SESSION_MINUTES=15

# ── IoT & Hardware Integration ───────────────────────────────────
# Header key required for NodeMCU ESP8266 telemetry POST requests
HARDWARE_DEVICE_KEY=vg-device-secure-key-2026

# ── Database Configuration ────────────────────────────────────────
# Option A: SQLite (default, zero configuration needed)
DB_TYPE=sqlite

# Option B: PostgreSQL (Recommended for distributed or cloud deployments)
# DATABASE_URL=postgresql://user:password@localhost:5432/venueguard

# Option C: MySQL 8.0+
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_mysql_password
# DB_NAME=venue_crowd

# ── Server Port ──────────────────────────────────────────────────
PORT=5000

# ── Venue & Event Configuration (Configurable by Admin) ──────────
EVENT_NAME=Community Cultural & Exhibition Gathering
EVENT_VENUE=City Grand Grounds & Exhibition Center
EVENT_DATE=2026-11-25
EVENT_CAPACITY=1000
EVENT_DESCRIPTION=Smart crowd management, zoned queuing, and visitor safety system.
